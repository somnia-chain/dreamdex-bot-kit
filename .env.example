# ── Required ────────────────────────────────────────────────────────────────
# The private key the bot signs with. For anything beyond testnet, prefer an
# encrypted keystore over a raw key (see docs/getting-started.md).
PRIVATE_KEY=0x...

# ── Network ─────────────────────────────────────────────────────────────────
# "testnet" (Shannon, chain 50312) or "mainnet" (chain 5031). Start on testnet.
NETWORK=testnet

# Optional RPC / API overrides. Sensible defaults per network are built in
# (see packages/core/src/config/networks.ts) — only set these to use your own.
# RPC_URL=
# REST_API_URL=
# WS_URL=

# ── Session keys (optional) ─────────────────────────────────────────────────
# For split-key / operator trading: set PRIVATE_KEY to your HOT operator key and
# OWNER_ADDRESS to the fund wallet it trades on behalf of. Orders then route
# through placeOrderFor and the hot key can never withdraw funds. One-time setup:
# scripts/operator-setup.ts (run with the fund key). See docs/session-keys.md.
# OWNER_ADDRESS=0x...

# ── SIWE (HTTP API auth) ────────────────────────────────────────────────────
# The Chain ID in the SIWE login message MUST match NETWORK: 5031 mainnet,
# 50312 testnet. The core sets this for you from NETWORK — do not override
# unless you know why (a mismatch is rejected). See docs/gotchas.md.

# ── Status logging ──────────────────────────────────────────────────────────
# Signal-driven strategies (grid, momentum, mean-reversion) only act when the
# market gives them a reason to, so they print a throttled status line saying
# what they're seeing and waiting for. How often, in ms (0 turns it off).
# STATUS_LOG_MS=30000

# ── Strategy knobs are in each strategy's own .env.example ───────────────────

# ── Event contracts (ec-* strategies) ────────────────────────────────────────
# Only needed to run the ec-* bots; the spot strategies ignore everything here.
# NETWORK above selects testnet/mainnet for these too.
#
# REQUIRED, and it DIFFERS PER NETWORK — one deployment hosts several venues and
# markets from all of them sit side by side in the indexer, so the bots refuse to
# guess. These moved three times in the first week of August, so treat the values
# below as a starting point: if a bot reports no markets, read the venueId off a
# live market row rather than trusting this file.
#
#   testnet  0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
#   mainnet  0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Every ec-* bot honours these.
DRY_RUN=true
# Winnings are claimed, not received: each bot sweeps settled markets on its own
# loop. Off only if something else does the claiming.
# AUTO_CLAIM=true
# AUTO_CLAIM_INTERVAL_MS=600000
# CLAIM_SCAN=25
# Minimum window left before a bot will act, in seconds. Unset it and each bot
# scales the requirement to the series cadence, which is usually what you want.
# EC_MIN_LEFT_S=

# ec-starter: how often to cross, how much per cross, and where to stop leaning.
# TAKE_INTERVAL_MS=8000
# TAKE_MAX_SHARES=5
# TAKE_MAX_POSITION=20

# ec-maker: half-spread in probability, shares per side, requote interval, and
# the net inventory past which it quotes only the side that unwinds.
# MM_SPREAD=0.02
# MM_QUOTE_SIZE=5
# MM_REFRESH_MS=10000
# MM_MAX_INVENTORY=20

# ec-passive: side, the probability you will pay, and where to stop.
# EC_REFRESH_MS=15000
# EC_SIDE=up
# EC_TARGET=0.40
# EC_SIZE=5
# EC_MAX_POSITION=20
# EC_UNDERLYING=BTC

# ec-laddering-bot: rungs each side of the mid, their spacing and size, and the
# net inventory cap. GRID_CENTER pins the mid instead of reading the book.
# GRID_LEVELS=2
# GRID_SPACING=0.05
# GRID_SIZE=5
# GRID_MAX_INVENTORY=20
# GRID_REFRESH_MS=10000
# GRID_HEARTBEAT_MS=30000
# GRID_FLATTEN_BUFFER_MS=
# EC_MARKET pins one exact market symbol instead of picking the longest window;
# ec-settlement honours it too.
# EC_MARKET=

# ec-settlement: CLAIM=1 sweeps settled markets and redeems what you won.
# CLAIM=1
# WATCH_POLL_MS=15000

# ec-oracle-follow: needs the UNDERLYING price feed, which is testnet-only today
# (see docs/event-contracts.md). PRICE_FEED_URL points it elsewhere.
# PRICE_FEED_URL=
#
# How much edge it wants before taking, and how big it is allowed to get.
# OF_EDGE=0.03
# OF_MAX_SHARES=5
# OF_MAX_EXPOSURE=50
# OF_INTERVAL_MS=8000
# OF_COOLDOWN_MS=30000
#
# The fair-value model: which spot to read, how stale it may be, and how the
# signal is shaped.
# OF_MODEL=
# OF_SPOT_SOURCE=
# OF_MAX_SPOT_AGE_MS=
# OF_SENSITIVITY=20
# OF_EXPECTED_MOVE=0.0015
# OF_MOMENTUM_THRESHOLD=0.0005
# OF_MOMENTUM_WINDOW_MS=60000
# OF_MIN_VOL=0.0002
# OF_VOL_WINDOW_MS=600000
#
# Guards: how far the model may disagree with the book before it stands down,
# how many windows it will hold at once, and when it stops trading a window.
# OF_MAX_DISAGREEMENT=0.1
# OF_MAX_HORIZONS=
# OF_NEAR_EXPIRY_STOP_MS=
# OF_HEARTBEAT_MS=

# ── Perps (testnet only) ────────────────────────────────────────────────────
# Perp pools are deployed on Shannon testnet; NETWORK=mainnet is refused at
# startup rather than connecting to an empty market list.
#
# PERP_SYMBOL is the app-canonical name you read off the market header, not the
# SDK's ccxt symbol. Leave it blank only for perp-guard, which then watches
# every market the account holds a position in.
# PERP_SYMBOL=BTC-PERP

# perp-starter: one leveraged position, managed with a take-profit and a
# stop-loss armed as a linked pair. PERP_NOTIONAL_USDSO is POSITION VALUE, not
# margin posted: at 2x, 50 costs about 25 in the bank.
# PERP_SIDE=long
# PERP_LEVERAGE=2
# PERP_NOTIONAL_USDSO=50
# PERP_TAKE_PROFIT_PCT=2
# PERP_STOP_LOSS_PCT=1
# PERP_TICK_MS=10000

# perp-maker: rests a bid and an ask around the mark, skewing to stay flat.
# PERP_MM_LEVERAGE=2
# PERP_MM_HALF_SPREAD_BPS=15
# PERP_MM_NOTIONAL_USDSO=25
# PERP_MM_MAX_POSITION_USDSO=100
# PERP_MM_INVENTORY_SKEW_BPS=10
# PERP_MM_REQUOTE_TRIGGER_BPS=8
# PERP_MM_REFRESH_MS=15000

# perp-funding: holds whichever side funding pays. The APRs are fractions, so
# 0.1 is 10%. The exit has to sit below the entry or the bot opens and closes
# on alternate polls.
# PERP_FUNDING_LEVERAGE=2
# PERP_FUNDING_MIN_APR=0.1
# PERP_FUNDING_EXIT_APR=0.03
# PERP_FUNDING_NOTIONAL_USDSO=50
# PERP_FUNDING_MAX_POSITION_USDSO=200
# PERP_FUNDING_POLL_MS=60000

# perp-guard: not a trader. Health is equity over the MAINTENANCE requirement,
# so 1.0 is the liquidation line. Flatten has to sit below reduce.
# PERP_GUARD_REDUCE_BELOW=1.5
# PERP_GUARD_REDUCE_PCT=25
# PERP_GUARD_FLATTEN_BELOW=1.15
# PERP_GUARD_POLL_MS=30000
